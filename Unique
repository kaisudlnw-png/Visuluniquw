local enabled = true

local function tween(object, properties, time)
    TweenService:Create(
        object,
        TweenInfo.new(time or 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        properties
    ):Play()
end

-- Toggle Function
toggle.MouseButton1Click:Connect(function()
    enabled = not enabled

    if enabled then
        toggleText.Text = "On"
        tween(toggle, {BackgroundColor3 = Color3.fromRGB(45, 205, 115)})
        tween(circle, {Position = UDim2.new(1, -44, 0.5, -20)})
        tween(dot, {BackgroundColor3 = Color3.fromRGB(50, 220, 120)})
        tween(glowStroke, {Transparency = 0.8})
        tween(glowStroke2, {Transparency = 0.92})
    else
        toggleText.Text = "Off"
        tween(toggle, {BackgroundColor3 = Color3.fromRGB(85, 88, 100)})
        tween(circle, {Position = UDim2.new(0, 4, 0.5, -20)})
        tween(dot, {BackgroundColor3 = Color3.fromRGB(230, 75, 85)})
        tween(glowStroke, {Transparency = 1})
        tween(glowStroke2, {Transparency = 1})
    end
end)

-- แอนิเมชันแสงรุ้งหมุน
RunService.RenderStepped:Connect(function()
    local rot = (tick() * 60) % 360
    borderGradient.Rotation = rot
    glowGradient.Rotation = rot
    glowGradient2.Rotation = rot
end)

-- Draggable GUI
local dragging = false
local dragStart
local startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

